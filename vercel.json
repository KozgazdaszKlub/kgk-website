{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "kgk-website.vercel.app" }],
      "status": 308,
      "headers": { "Location": "https://kozgazdaszklub.com/$1" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.kozgazdaszklub.com" }],
      "status": 308,
      "headers": { "Location": "https://kozgazdaszklub.com/$1" }
    },
    { "src": "/hir\\.html", "dest": "/api/og-hir" },
    { "src": "/sitemap\\.xml", "dest": "/api/sitemap" }
  ],
  "functions": {
    "api/og-hir.js": {
      "includeFiles": "hir.html"
    }
  }
}
